<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tb_surface"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/prevDay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_day"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/tb_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/tb_text_secondary"
                android:textSize="15sp"
                tools:text="Today · Thu, 24 Sep" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/nextDay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_day"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <!-- Now: the block you should be executing right this second. -->
            <LinearLayout
                android:id="@+id/nowCard"
                style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/card_now" />

                <View style="@style/CardDivider" />

                <FrameLayout
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp">

                    <com.mid.timeboxing.ui.RingView
                        android:id="@+id/nowRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp">

                        <TextView
                            android:id="@+id/nowCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/tb_ink"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            tools:text="24:13" />

                        <TextView
                            android:id="@+id/nowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/tb_text_secondary"
                            android:textSize="17sp"
                            tools:text="Deep work: engine design" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <include
                        android:id="@+id/nowStat1"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/nowStat2"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/nowStat3"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nowAction"
                    style="@style/Widget.Timeboxing.Button"
                    android:layout_margin="16dp"
                    tools:text="@string/action_mark_done" />
            </LinearLayout>

            <!-- Top 3 -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/card_priorities" />

                <View style="@style/CardDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Hint"
                        android:layout_marginBottom="12dp"
                        android:text="@string/priorities_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_index"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/tb_on_button"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <EditText
                            android:id="@+id/priority1"
                            style="@style/Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/priority_1_hint"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_index"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/tb_on_button"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <EditText
                            android:id="@+id/priority2"
                            style="@style/Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/priority_2_hint"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_index"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/tb_on_button"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <EditText
                            android:id="@+id/priority3"
                            style="@style/Field"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/priority_3_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Day Analysis -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/card_analysis" />

                <View style="@style/CardDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="20dp">

                    <include
                        android:id="@+id/statBoxed"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statBlocks"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statDone"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statOpen"
                        layout="@layout/stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5-minute grid -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/card_grid" />

                <View style="@style/CardDivider" />

                <com.mid.timeboxing.ui.DayGridView
                    android:id="@+id/dayGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_block_boxed" />

                    <TextView
                        style="@style/LegendLabel"
                        android:text="@string/legend_boxed" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_block_done" />

                    <TextView
                        style="@style/LegendLabel"
                        android:text="@string/legend_done" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_block_empty" />

                    <TextView
                        style="@style/LegendLabel"
                        android:layout_marginEnd="0dp"
                        android:text="@string/legend_free" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/grid_hint" />
            </LinearLayout>

            <!-- Schedule -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/card_schedule" />

                <View style="@style/CardDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="0dp" />

                    <TextView
                        style="@style/TableHead"
                        android:text="@string/col_start" />

                    <TextView
                        style="@style/TableHead"
                        android:text="@string/col_end" />

                    <TextView
                        style="@style/TableHead"
                        android:text="@string/col_minutes" />

                    <TextView
                        style="@style/TableHead"
                        android:layout_weight="2"
                        android:gravity="start"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        android:text="@string/col_task" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scheduleRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/scheduleEmpty"
                    style="@style/Hint"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="8dp"
                    android:text="@string/schedule_empty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addBox"
                    style="@style/Widget.Timeboxing.Button"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/action_add_box"
                    app:icon="@drawable/ic_add" />

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/schedule_hint" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:layout_marginTop="24dp"
                android:text="@string/footer_motto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
